# Use mock only for offline UI development. Production should use openai.
VISION_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_server_side_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1
PORT=3001
CORS_ORIGIN=*
MAX_IMAGE_MB=8
ANALYZE_RATE_LIMIT_MAX=30
ANALYZE_RATE_LIMIT_WINDOW_MS=3600000
